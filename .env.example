# Example environment configuration
# Copy this file to .env and customize as needed

# Data paths
DATA_PATH=./data
CHECKPOINT_PATH=./checkpoints
RESULTS_PATH=./results

# PyTorch/GPU settings
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda

# Training settings
DEFAULT_BATCH_SIZE=32
DEFAULT_EPOCHS=100
DEFAULT_LR=0.001

# Logging and monitoring
WANDB_PROJECT=twsa-hignn-lstm
WANDB_ENTITY=your-username
LOG_LEVEL=INFO

# Data preprocessing
GRACE_DATA_PATH=./data/raw/grace
ERA5_DATA_PATH=./data/raw/era5
PROCESSED_DATA_PATH=./data/processed

# Model paths
HIGNN_CONFIG=./configs/config_heterograph.yaml
CONVLSTM_CONFIG=./configs/config2D.yaml

# Evaluation settings
EVAL_BATCH_SIZE=32
EVAL_DEVICE=cuda
