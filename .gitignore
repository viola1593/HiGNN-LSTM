# Data and checkpoints
# NOTE: use "dir/*" rather than "dir/", otherwise the "!" re-includes below have no
# effect - git does not descend into an excluded directory.
data/*
!data/README.md

!checkpoints/README.md

# Outputs and results
eval_on_*/
eval_GNNembedding*/
figures/
experiments/
results/
neurips_exp/
finetune/
feature_importance/
fi_analysis/
figures_deaseas/

# Precomputed graph structure: the edge indices, the ocean k-means model and the
# land-point-to-basin lookup are tracked (~1.8 MB) so that the heterogeneous graph
# is bit-identical to the one the released checkpoints were trained on.
# Cluster diagnostic plots are regenerated at runtime and stay ignored.
graphs/*
graphs_archived/
!graphs/*/
graphs/*/*
!graphs/*/*.pt
!graphs/*/*.pkl
!graphs/*/landpoints_to_basin.csv


